{
  "version": "0.4.0-alpha",
  "containerId": "MxcBrokerHostListTest",
  "containment": "processcontainer",
  "process": {
    "commandLine": "curl.exe --max-time 5 -sS -o NUL -w HTTP=%{http_code}_TIME=%{time_total}_ERR=%{errormsg} http://8.8.8.8",
    "cwd": "C:\\Windows",
    "timeout": 30000
  },
  "processContainer": {
    "capabilities": ["internetClient"]
  },
  "network": {
    "enforcementMode": "firewall",
    "defaultPolicy": "allow",
    "blockedHosts": ["8.8.8.8"]
  },
  "lifecycle": {
    "destroy_on_exit": true
  }
}

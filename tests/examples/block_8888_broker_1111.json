{
  "version": "0.4.0-alpha",
  "containerId": "MxcBlock8888Test",
  "containment": "processcontainer",
  "process": {
    "commandLine": "curl.exe --max-time 4 -sS -o NUL -w EXIT=%{http_code} http://1.1.1.1",
    "cwd": "C:\\Windows",
    "timeout": 30000
  },
  "processContainer": {
    "capabilities": ["internetClient"]
  },
  "network": {
    "enforcementMode": "capabilities",
    "defaultPolicy": "allow"
  },
  "lifecycle": {
    "destroy_on_exit": false
  }
}

<?xml version="1.0" encoding="utf-8"?>
<!--
  Copyright (c) Microsoft Corporation.
  Licensed under the MIT License.

  WiX 5+ source for the mxc-service MSI. Implements spec §4.1 service
  identity:

    * Service runs as NT AUTHORITY\LocalService (NOT LocalSystem).
    * `sc sidtype mxc-service restricted` — gives the service token
      SERVICE_SID_TYPE_RESTRICTED. The four-SID restricted list (per-
      service SID, World, service logon SID, S-1-5-33) means write
      access succeeds only where a DACL explicitly grants one of those.
    * `sc privs mxc-service SeChangeNotifyPrivilege` — strips ambient
      privileges to the floor (SeChangeNotify is required for path
      resolution; everything else is dropped).
    * mxc-service.exe install-grant flag (custom action, runs as
      LocalSystem during deferred install): writes a **non-inheritable**
      ACE on the BFE engine SD granting NT SERVICE\mxc-service:
        FWPM_ACTRL_OPEN | FWPM_ACTRL_ADD
      That is the floor: OPEN to open an engine session, ADD to create
      our top-level provider + sublayer at service startup. The service
      is then the creator/owner of those objects (and of filters added
      under them), so WFP grants it implicit full access on its own
      namespace without any further ACEs. Non-inheritable means our
      rights do **not** leak to other providers' WFP objects.

  Sequencing (after InstallServices, before StartServices):
      InstallServices
        → SetSidType         (sc sidtype)
        → SetPrivs           (sc privs)
        → GrantWfpRights     (mxc-service.exe install-grant flag)
      StartServices

  On uninstall, RevokeWfpRights runs before service stop/remove and is
  best-effort (it's fine if the SID is already gone). Service still
  starts on install; MajorUpgrade still replaces prior installs.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="MXC Tier 2 Service"
      Manufacturer="Microsoft Corporation (MXC Prototype)"
      Version="$(var.ProductVersion)"
      UpgradeCode="7a3d1bb0-3f1e-4d7a-9c4e-5a36f51e9b00"
      Scope="perMachine"
      InstallerVersion="500">

    <MajorUpgrade
        DowngradeErrorMessage="A newer version of [ProductName] is already installed."
        Schedule="afterInstallInitialize"/>

    <MediaTemplate EmbedCab="yes" />

    <Feature Id="MainFeature" Title="MXC Tier 2 Service" Level="1">
      <ComponentGroupRef Id="ServiceFiles" />
    </Feature>

    <!-- Custom actions: see header for full rationale. -->
    <CustomAction Id="SetSidType"
                  Directory="INSTALLFOLDER"
                  ExeCommand="[SystemFolder]sc.exe sidtype mxc-service restricted"
                  Execute="deferred"
                  Impersonate="no"
                  Return="check" />

    <CustomAction Id="SetPrivs"
                  Directory="INSTALLFOLDER"
                  ExeCommand="[SystemFolder]sc.exe privs mxc-service SeChangeNotifyPrivilege"
                  Execute="deferred"
                  Impersonate="no"
                  Return="check" />

    <CustomAction Id="GrantWfpRights"
                  FileRef="MxcServiceExe"
                  ExeCommand="--install-grant"
                  Execute="deferred"
                  Impersonate="no"
                  Return="check" />

    <CustomAction Id="RevokeWfpRights"
                  FileRef="MxcServiceExe"
                  ExeCommand="--uninstall-grant"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <InstallExecuteSequence>
      <!-- Install-time: tighten service identity, then grant engine ACE. -->
      <Custom Action="SetSidType"     After="InstallServices"  Condition="NOT REMOVE=&quot;ALL&quot;" />
      <Custom Action="SetPrivs"       After="SetSidType"       Condition="NOT REMOVE=&quot;ALL&quot;" />
      <Custom Action="GrantWfpRights" After="SetPrivs"         Condition="NOT REMOVE=&quot;ALL&quot;" />

      <!-- Uninstall-time: revoke ACE before the service is stopped/deleted. -->
      <Custom Action="RevokeWfpRights" Before="StopServices"   Condition="REMOVE=&quot;ALL&quot;" />
    </InstallExecuteSequence>
  </Package>

  <Fragment>
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="CompanyFolder" Name="Microsoft">
        <Directory Id="INSTALLFOLDER" Name="MXC Service" />
      </Directory>
    </StandardDirectory>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="ServiceFiles" Directory="INSTALLFOLDER">
      <Component Id="MxcServiceExeCmp" Guid="7a3d1bb1-3f1e-4d7a-9c4e-5a36f51e9b01">
        <File Id="MxcServiceExe"
              Source="$(var.ServiceBinaryDir)\mxc-service.exe"
              KeyPath="yes" />
        <ServiceInstall Id="MxcServiceInstall"
                        Type="ownProcess"
                        Name="mxc-service"
                        DisplayName="MXC Tier 2 Service"
                        Description="MXC Tier 2 WFP broker. Runs as restricted LocalService per spec §4.1."
                        Start="auto"
                        Account="NT AUTHORITY\LocalService"
                        ErrorControl="normal"
                        Vital="yes" />
        <ServiceControl Id="MxcServiceControl"
                        Name="mxc-service"
                        Start="install"
                        Stop="both"
                        Remove="uninstall"
                        Wait="yes" />
      </Component>

      <Component Id="MxcNetExeCmp" Guid="7a3d1bb2-3f1e-4d7a-9c4e-5a36f51e9b02">
        <File Id="MxcNetExe"
              Source="$(var.ServiceBinaryDir)\mxc-net.exe"
              KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
